# Firebase Firestore Security Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // CVs collection
    match /cvs/{cvId} {
      // Allow read if user is authenticated and owns the CV
      allow read: if isOwner(cvId);
      
      // Allow create if user is authenticated and creating their own CV
      allow create: if isAuthenticated() && request.auth.uid == cvId;
      
      // Allow update/delete only if user owns the CV
      allow update, delete: if isOwner(cvId);
    }
    
    // Users collection (if you add user profiles)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
  }
}

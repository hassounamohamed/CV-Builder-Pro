// Firebase Firestore Security Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // CVs collection
    match /cvs/{cvId} {
      // Owner can always read, public can read only explicitly shared CVs
      allow read: if isOwner(cvId) || resource.data.isShared == true;
      
      // Allow create if user is authenticated and creating their own CV
      allow create: if isAuthenticated() && request.auth.uid == cvId;
      
      // Allow update/delete only if user owns the CV
      allow update, delete: if isOwner(cvId);
    }
    
    // Users collection (if you add user profiles)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Feedbacks / reviews collection
    // Anyone can read feedbacks (shown publicly on landing page)
    // Anyone can submit feedback
    match /feedbacks/{feedbackId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
